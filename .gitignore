# Local competition datasets and attachments.
# Keep these files on disk; commit manifests/checksums instead.
/projects/**/problem/data/**
/projects/**/problem/attachments/**

# Keep raw-data recovery instructions tracked while datasets stay local.
!/projects/**/problem/data/
!/projects/**/problem/data/README.md

# Keep new files in rehearsal projects local; tracked files still require selective staging.
/projects/rehearsal_2024_B/
/projects/rehearsal_2024_C/

# Local plugin and MCP installations.
/.agents/plugins/
/tools/penpot_mcp/
# Python runtime caches.
__pycache__/
*.py[cod]

# Ignore CSV files anywhere under the projects directory
/projects/**/*.csv
sshconfig.md
